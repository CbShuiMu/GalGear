{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GalGear",
  "version": "0.6.5",
  "identifier": "com.galgear.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "GalGear",
        "width": 1240,
        "height": 820,
        "minWidth": 1122,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "backgroundColor": "#FBF7FA",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self'; img-src 'self' data: http://galgear-cover.localhost galgear-cover: http://galgear-icon.localhost galgear-icon: http://galgear-background.localhost galgear-background: https://t.vndb.org https://s.vndb.org https://lain.bgm.tv https://store.ymgal.games https://image.kungal.iloveren.link https://img.achost.top https://2dfmax.top https://2dfdf.de https://2dfan.com https://fan2d.top https://acgfan.top; connect-src ipc: http://ipc.localhost 'self'; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "resources": {
      "../tools/7zip/": "tools/7zip/",
      "../tools/font-hook/": "tools/font-hook/",
      "../tools/ai-agent/": "tools/ai-agent/",
      "../tools/waifu2x/": "tools/waifu2x/",
      "../tools/magpie/": "tools/magpie/",
      "../tools/locale-emulator/LEPProc_x86.exe": "tools/locale-emulator/LEPProc_x86.exe",
      "../tools/locale-emulator/LEPProc_x64.exe": "tools/locale-emulator/LEPProc_x64.exe",
      "../tools/locale-emulator/LEPCommonLibrary.dll": "tools/locale-emulator/LEPCommonLibrary.dll",
      "../tools/locale-emulator/LEPGUI.exe": "tools/locale-emulator/LEPGUI.exe",
      "../tools/locale-emulator/LoaderDll_x86.dll": "tools/locale-emulator/LoaderDll_x86.dll",
      "../tools/locale-emulator/LoaderDll_x64.dll": "tools/locale-emulator/LoaderDll_x64.dll",
      "../tools/locale-emulator/LocaleEmulatorPlus_x86.dll": "tools/locale-emulator/LocaleEmulatorPlus_x86.dll",
      "../tools/locale-emulator/LocaleEmulatorPlus_x64.dll": "tools/locale-emulator/LocaleEmulatorPlus_x64.dll",
      "../tools/locale-emulator/LEPVersion.xml": "tools/locale-emulator/LEPVersion.xml",
      "../tools/locale-emulator/COPYING": "tools/locale-emulator/COPYING",
      "../tools/locale-emulator/COPYING.LESSER": "tools/locale-emulator/COPYING.LESSER",
      "../tools/locale-emulator/README_ORG.md": "tools/locale-emulator/README_ORG.md",
      "../tools/locale-emulator/bundle.json": "tools/locale-emulator/bundle.json",
      "../tools/locale-emulator/Lang/": "tools/locale-emulator/Lang/",
      "../LICENSE": "LICENSE",
      "../NOTICE": "NOTICE",
      "../LICENSES/": "LICENSES/"
    },
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "shortDescription": "粉红色的本地 Galgame 游戏库",
    "category": "Utility",
    "license": "GPL-3.0-only",
    "licenseFile": "../LICENSE"
  }
}
